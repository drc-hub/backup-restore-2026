# =============================================================================
# backup.env  —  Primary VM backup pipeline environment
#
# Source this before running the backup orchestrator or any backup tool:
#   source utilities/backup/backup.env
#
# Or set permanently in /etc/environment (requires re-login).
# =============================================================================

# ---------------------------------------------------------------------------
# Chain versioning (Feature 4)
# ---------------------------------------------------------------------------
# Starting chain version. Automatically incremented in the state DB after
# each successful restore (--bump-chain-version). Override only to force a
# fresh chain directory (e.g. after manual recovery).
export CHAIN_VERSION_INIT="chain-v1"

# ---------------------------------------------------------------------------
# Transfer to Recovery VM (Feature 3)
# ---------------------------------------------------------------------------
# Enable the transfer step at the end of every backup cycle.
export TRANSFER_ENABLE="1"

# Comma-separated list of rsync destinations.
# Format: [user@host:/abs/path] or [/local/abs/path]
# Cycles land as: <target>/chain-v1/<cycle_id>/
export RECOVERY_RSYNC_TARGETS="recovery@192.168.10.129:/home/recovery/local-backup/incoming"

# SSH key for the recovery VM (passwordless, backup-only key).
export RECOVERY_SSH_KEY="/home/primary/.ssh/recovery_rsync_ed25519"

# SSH port for the recovery VM (default 22).
export RECOVERY_SSH_PORT="22"

# ---------------------------------------------------------------------------
# WAL archiving
# ---------------------------------------------------------------------------
export PG_WAL_ARCHIVE="/home/primary/data/transactional/postgres/wal_archive"
export PG_BASEBACKUP_ENABLE="1"

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
export RETENTION_MAX_CYCLES="30"
# 50 GiB max total size per chain directory
export RETENTION_MAX_BYTES="53687091200"

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------
export TRANSFER_VERIFY="1"
export TRANSFER_VERIFY_RAW="0"
